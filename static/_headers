/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY

# The page itself is always revalidated, so a deploy is picked up on the next visit.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Scripts, styles and seasonal art are referenced as ?v=<commit> (stamped by CI,
# see scripts/stamp-version.sh), so each deploy gets new URLs: safe to cache forever.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/fx/art/*
  Cache-Control: public, max-age=31536000, immutable

# Icons rarely change and have no version in the URL: cache a day.
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon-32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
